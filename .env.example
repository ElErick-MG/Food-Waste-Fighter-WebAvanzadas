# Run npm run setup:env to create .env with unique development secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Use the actual forwarded HTTPS origin in Codespaces (used by CSRF/recovery and Socket.IO).
APP_ORIGIN=http://localhost:3000
BUSINESS_TIMEZONE=America/Guayaquil
# Codespaces has one trusted reverse proxy. Use 0 for direct local HTTP.
TRUST_PROXY=0
MYSQL_DATABASE=food_waste_fighter
MYSQL_USER=fwf_app
MYSQL_PORT=3306
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=
SESSION_SECRET=
# Independent test container/database; never point this at development.
TEST_MYSQL_DATABASE=food_waste_fighter_test
TEST_MYSQL_USER=fwf_test
TEST_MYSQL_PORT=3307
TEST_MYSQL_PASSWORD=
TEST_MYSQL_ROOT_PASSWORD=
TEST_DATABASE_URL=
