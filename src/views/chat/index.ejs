<!DOCTYPE html>
<html lang="es" class="fwf-raiz">
<head><%- include('../partials/fwf-head', { title: 'Chat del equipo', estilos: ['fwf-app', 'chat'], modulos: ['chat'] }) %></head>
<body class="fwf">
<a class="salto" href="#main-content">Saltar al contenido</a>
<div id="escena" aria-hidden="true">
  <div id="cocinaCapa"><img id="cocinaFoto" src="/assets/fwf/img/cocina.png" alt="" width="1670" height="941"><div id="cocinaVelo"></div></div>
</div>
<div class="chat-capa">
  <div class="chat-marco">
