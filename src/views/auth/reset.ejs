<%- include('../partials/fwf-acceso-inicio', { title: 'Crear nueva contraseña', titulo: 'Crear nueva contraseña', sub: 'Elige una contraseña de al menos 12 caracteres.', error, message }) %>
    <form method="post" action="/auth/reset" data-password-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= values.token %>">
      <%- include('../partials/fwf-clave', { id: 'password', name: 'password', label: 'Nueva contraseña', autocomplete: 'new-password', placeholder: 'Mínimo 12 caracteres', minlength: 12 }) %>
      <%- include('../partials/fwf-clave', { id: 'confirmPassword', name: 'confirmPassword', label: 'Confirmar Contraseña', autocomplete: 'new-password', placeholder: 'Repite tu contraseña', describedby: 'errorContrasena' }) %>
      <p id="errorContrasena" class="err hidden" aria-live="polite">Las contraseñas no coinciden</p>
      <button type="submit" class="btn btn-pri btn-grande acc-enviar">Guardar contraseña</button>
    </form>
    <p class="acc-pie"><a class="enlace" href="/auth/login">Volver a iniciar sesión</a></p>
<%- include('../partials/fwf-acceso-fin') %>
