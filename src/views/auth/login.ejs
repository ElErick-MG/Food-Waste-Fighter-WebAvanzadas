<%- include('../partials/fwf-acceso-inicio', { title: 'Iniciar Sesión', titulo: 'Iniciar Sesión', sub: 'Entra para ver lo que caduca primero en tu cocina.', error, message }) %>
    <form action="/auth/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo">
        <label for="email">Correo Electrónico</label>
        <input type="email" id="email" name="email" autocomplete="email" inputmode="email" maxlength="254" value="<%= values.email || '' %>" required placeholder="tu@email.com">
      </div>
      <%- include('../partials/fwf-clave', { id: 'contrasena', name: 'password', label: 'Contraseña', autocomplete: 'current-password', placeholder: '' }) %>
      <button type="submit" class="btn btn-pri btn-grande acc-enviar">Iniciar Sesión</button>
    </form>
    <p class="acc-pie"><a class="enlace" href="/auth/forgot">¿Olvidaste tu contraseña?</a></p>
    <p class="acc-pie ayuda">¿No tienes cuenta? <a class="enlace" href="/auth/register">Regístrate aquí</a></p>
<%- include('../partials/fwf-acceso-fin') %>
