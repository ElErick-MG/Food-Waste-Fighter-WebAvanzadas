<%- include('../partials/fwf-acceso-inicio', { title: 'Crear Cuenta', titulo: 'Crear Cuenta', sub: 'Empieza gratis a controlar lo que caduca en tu cocina.', error, message: null }) %>
    <form action="/auth/register" method="post" data-password-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo">
        <label for="companyName">Nombre de la cafetería o restaurante</label>
        <input type="text" id="companyName" name="companyName" autocomplete="organization" required minlength="2" maxlength="120" value="<%= values.companyName || '' %>" placeholder="Tu negocio">
      </div>
      <div class="campo">
        <label for="nombre">Nombre Completo</label>
        <input type="text" id="nombre" name="name" autocomplete="name" required minlength="2" maxlength="120" value="<%= values.name || '' %>" placeholder="Tu nombre">
      </div>
      <div class="campo">
        <label for="email">Correo Electrónico</label>
        <input type="email" id="email" name="email" autocomplete="email" inputmode="email" maxlength="254" value="<%= values.email || '' %>" required placeholder="tu@email.com">
      </div>
      <%- include('../partials/fwf-clave', { id: 'contrasena', name: 'password', label: 'Contraseña', autocomplete: 'new-password', placeholder: 'Mínimo 12 caracteres', minlength: 12 }) %>
      <%- include('../partials/fwf-clave', { id: 'confirmarContrasena', name: 'confirmPassword', label: 'Confirmar Contraseña', autocomplete: 'new-password', placeholder: 'Repite tu contraseña', describedby: 'errorContrasena' }) %>
      <p id="errorContrasena" class="err hidden" aria-live="polite">Las contraseñas no coinciden</p>
      <button type="submit" class="btn btn-pri btn-grande acc-enviar">Crear Cuenta</button>
    </form>
    <p class="acc-pie ayuda">¿Ya tienes cuenta? <a class="enlace" href="/auth/login">Inicia sesión</a></p>
<%- include('../partials/fwf-acceso-fin') %>
