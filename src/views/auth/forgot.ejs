<!doctype html>
<html lang="es"><head><%- include('../partials/head', { title: 'Recuperar contraseña' }) %></head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex items-center justify-center">
 <main class="w-full max-w-md p-6"><div class="text-center mb-8"><%- include('../partials/logo') %></div>
 <div class="bg-white p-8 rounded-xl shadow-lg"><h1 class="text-2xl font-bold text-center mb-6">Recuperar contraseña</h1>
 <% if (error) { %><div role="alert" class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded text-red-700"><%= error %></div><% } %>
 <% if (message) { %><p role="status" class="bg-green-50 border-l-4 border-green-500 p-4 mb-6 rounded text-green-700"><%= message %></p><% } %>
 <form method="post" action="/auth/forgot" data-password-form>
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <p class="text-gray-600 mb-6">Se enviará un enlace al correo de tu cuenta para crear una nueva contraseña.</p>
 <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico</label>
 <input type="email" id="email" name="email" autocomplete="email" required maxlength="254" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">

 <button class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors mt-6">Enviar enlace</button>
 </form><p class="text-center mt-6"><a href="/auth/login" class="text-green-600 hover:text-green-700 font-medium">Volver a iniciar sesión</a></p>
 </div></main></body></html>
