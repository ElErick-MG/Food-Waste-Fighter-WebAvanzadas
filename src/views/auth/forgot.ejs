<%- include('../partials/fwf-acceso-inicio', { title: 'Recuperar contraseña', titulo: 'Recuperar contraseña', sub: 'Se enviará un enlace al correo de tu cuenta para crear una nueva contraseña.', error, message }) %>
    <form method="post" action="/auth/forgot">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo">
        <label for="email">Correo Electrónico</label>
        <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" placeholder="tu@email.com">
      </div>
      <button type="submit" class="btn btn-pri btn-grande acc-enviar">Enviar enlace</button>
    </form>
    <p class="acc-pie"><a class="enlace" href="/auth/login">Volver a iniciar sesión</a></p>
<%- include('../partials/fwf-acceso-fin') %>
