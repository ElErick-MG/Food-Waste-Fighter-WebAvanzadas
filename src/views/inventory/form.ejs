<!doctype html>
<html lang="es"><head><%- include('../partials/head', { title: editing ? 'Editar Producto' : 'Añadir Producto' }) %><script src="/assets/inventory.js" defer></script></head>
<body class="bg-gray-50 text-gray-800"><%- include('../partials/navigation') %>
<!-- Form and input/button classes from registrarAlimento.jsp / editarAlimento.jsp. -->
<main id="main-content" class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8"><a href="/inventory" class="inline-flex text-green-700 font-medium mb-6">← Volver al Inventario</a><h1 class="text-3xl font-bold text-center mb-8"><%= editing ? 'Editar Producto' : 'Añadir Producto' %></h1>
  <div class="max-w-lg mx-auto"><div class="bg-white p-8 rounded-xl shadow-lg">
    <% if (error) { %><p role="alert" class="bg-red-50 text-red-800 rounded-lg p-4 mb-6"><%= error %></p><% } %>
    <% if (!categories.length) { %><p class="bg-yellow-50 text-yellow-800 p-4 rounded-lg mb-6">No hay categorías. <% if (currentUser.role === 'ADMIN') { %><a href="/categories" class="underline">Crea una categoría</a><% } else { %>Solicita una a administración.<% } %></p><% } %>
    <form method="post" action="<%= editing ? '/inventory/' + id + '/edit' : '/inventory' %>" data-inventory-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2 class="text-xl font-semibold mb-6">Información del Producto</h2>
      <div class="mb-4"><label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nombre del Producto</label><input id="name" name="name" type="text" required minlength="2" maxlength="120" value="<%= values.name || '' %>" placeholder="ej. Leche, Manzanas, Pollo" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500"></div>
      <div class="mb-4"><label for="categoryId" class="block text-sm font-medium text-gray-700 mb-1">Categoría</label><select id="categoryId" name="categoryId" required class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white"><option value="">Selecciona una categoría</option><% for (const category of categories) { %><option value="<%= category.id %>" <%= values.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option><% } %></select></div>
      <% for (const [key, label] of [['quantity', 'Cantidad'], ['minimumStock', 'Stock mínimo']]) { %><div class="mb-4"><label for="<%= key %>" class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label><input id="<%= key %>" name="<%= key %>" type="number" required min="0" max="999999999.999" step="0.001" value="<%= values[key] || '' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg"></div><% } %>
      <div class="mb-4"><label for="unit" class="block text-sm font-medium text-gray-700 mb-1">Unidad</label><select id="unit" name="unit" required class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white"><% for (const unit of ['kg', 'g', 'l', 'ml', 'unidad']) { %><option value="<%= unit %>" <%= values.unit === unit ? 'selected' : '' %>><%= unit %></option><% } %></select></div>
      <% for (const [key, label] of [['receivedDate', 'Fecha de Ingreso'], ['expiresDate', 'Fecha de Caducidad']]) { %><div class="mb-4"><label for="<%= key %>" class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label><input id="<%= key %>" name="<%= key %>" type="date" required min="1000-01-01" max="9999-12-31" value="<%= values[key] || '' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg"></div><% } %>
      <p class="text-sm text-gray-600 mb-6">Hasta 3 decimales. La caducidad debe ser igual o posterior al ingreso.</p><div class="flex flex-wrap gap-3"><button class="flex-1 bg-green-600 text-white px-4 py-3 rounded-lg font-semibold hover:bg-green-700">Guardar Producto</button><a href="/inventory" class="flex-1 bg-gray-200 text-gray-700 px-4 py-3 rounded-lg font-semibold text-center">Cancelar</a></div>
    </form>
  </div></div>
</main></body></html>
