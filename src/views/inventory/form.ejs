<%- include('../partials/fwf-ficha-inicio', { title: editing ? 'Editar Producto' : 'Añadir Producto', volver: editing ? '/inventory/' + id : '/inventory', scripts: ['/assets/inventory.js'] }) %>
    <p class="etiqueta ficha-marca">Tu refri</p>
    <h1 id="ficha-titulo" class="t-modal"><%= editing ? 'Editar Producto' : 'Añadir Producto' %></h1>
    <p class="ficha-sub ayuda">Todos los campos son obligatorios salvo la imagen.</p>
    <% if (error) { %><div role="alert" class="ficha-aviso error"><%= error %></div><% } %>
    <% if (!categories.length) { %><p class="ficha-aviso pronto">No hay categorías. <% if (currentUser.role === 'ADMIN') { %><a href="/categories" class="enlace">Crea una categoría</a><% } else { %>Solicita una a administración.<% } %></p><% } %>
    <form method="post" action="<%= editing ? '/inventory/' + id + '/edit' : '/inventory' %>" data-inventory-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo"><label for="name">Nombre del Producto</label><input id="name" name="name" type="text" required minlength="2" maxlength="120" value="<%= values.name || '' %>" placeholder="ej. Leche, Manzanas, Pollo"></div>
      <div class="campo"><label for="categoryId">Categoría</label><select id="categoryId" name="categoryId" required><option value="">Selecciona una categoría</option><% for (const category of categories) { %><option value="<%= category.id %>" <%= values.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option><% } %></select></div>
      <div class="ficha-par">
        <div class="campo"><label for="quantity">Cantidad</label><input id="quantity" name="quantity" type="number" inputmode="decimal" required min="0" max="999999999.999" step="0.001" value="<%= values.quantity || '' %>"></div>
        <div class="campo"><label for="unit">Unidad</label><select id="unit" name="unit" required><% for (const unit of ['kg', 'g', 'l', 'ml', 'unidad']) { %><option value="<%= unit %>" <%= values.unit === unit ? 'selected' : '' %>><%= unit %></option><% } %></select></div>
      </div>
      <div class="campo"><label for="minimumStock">Stock mínimo</label><input id="minimumStock" name="minimumStock" type="number" inputmode="decimal" required min="0" max="999999999.999" step="0.001" value="<%= values.minimumStock || '' %>" aria-describedby="ayuda-decimales"></div>
      <div class="ficha-par">
        <div class="campo"><label for="receivedDate">Fecha de Ingreso</label><input id="receivedDate" name="receivedDate" type="date" required min="1000-01-01" max="9999-12-31" value="<%= values.receivedDate || '' %>"></div>
        <div class="campo"><label for="expiresDate">Fecha de Caducidad</label><input id="expiresDate" name="expiresDate" type="date" required min="1000-01-01" max="9999-12-31" value="<%= values.expiresDate || '' %>"></div>
      </div>
      <div class="campo"><label for="imageUrl">Imagen del producto (opcional)</label><input id="imageUrl" name="imageUrl" type="url" maxlength="500" pattern="https://.*" value="<%= values.imageUrl || '' %>" placeholder="https://…" aria-describedby="imageUrl-help"><p id="imageUrl-help" class="ayuda">Dirección completa que empiece por https://. Déjala vacía para quitar la imagen.</p></div>
      <p id="ayuda-decimales" class="ayuda">Hasta 3 decimales. La caducidad debe ser igual o posterior al ingreso.</p>
      <div class="ficha-botones"><button type="submit" class="btn btn-pri btn-grande">Guardar Producto</button><a href="<%= editing ? '/inventory/' + id : '/inventory' %>" class="btn btn-sec btn-grande">Cancelar</a></div>
    </form>
<%- include('../partials/fwf-ficha-fin') %>
