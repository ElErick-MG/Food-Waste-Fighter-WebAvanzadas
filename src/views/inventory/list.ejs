<!doctype html>
<html lang="es"><head><%- include('../partials/head', { title: expirationPage ? 'Productos por Caducar' : 'Mi Inventario' }) %></head>
<body class="bg-gray-50 text-gray-800"><%- include('../partials/navigation') %>
<!-- Table and expiration palette from listarAlimentos.jsp / productosACaducar.jsp. -->
<main id="main-content" class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-6"><h1 class="text-3xl font-bold"><%= expirationPage ? 'Productos por Caducar' : 'Mi Inventario' %></h1><a href="/inventory/new" class="bg-green-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-700">+ Añadir Producto</a></div><%- include('../partials/notice') %>
  <% if (expirationPage) { %><div class="bg-white rounded-xl shadow-sm p-4 mb-6 flex flex-wrap gap-4 items-center"><span class="font-medium">Leyenda:</span><span class="text-red-800">Caducado: antes de hoy</span><span class="text-red-700">Crítico: hoy–2 días</span><span class="text-yellow-800">Advertencia: 3–5 días</span><span class="text-gray-600">Normal: 6+ días</span></div><% } %>
  <form method="get" class="bg-white rounded-xl shadow-sm p-4 mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div><label for="q" class="block text-sm font-medium mb-1">Buscar por nombre o categoría</label><input id="q" name="q" value="<%= filters.q %>" maxlength="80" class="w-full px-4 py-3 border border-gray-300 rounded-lg"></div>
    <div><label for="categoryId" class="block text-sm font-medium mb-1">Categoría</label><select id="categoryId" name="categoryId" class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white"><option value="">Todas</option><% for (const category of categories) { %><option value="<%= category.id %>" <%= filters.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option><% } %></select></div>
    <div><label for="status" class="block text-sm font-medium mb-1">Estado</label><select id="status" name="status" class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white"><% for (const [value, label] of [['', 'Todos'], ['soon', 'Próximos (0–5 días)'], ['expired', 'Caducados'], ['critical', 'Críticos (0–2 días)'], ['warning', 'Advertencia (3–5 días)'], ['normal', 'Normal (6+ días)'], ['low', 'Stock bajo']]) { %><option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option><% } %></select></div>
    <div class="flex flex-wrap items-end gap-3"><button class="bg-green-600 text-white px-4 py-3 rounded-lg font-medium hover:bg-green-700">Buscar</button><a href="<%= expirationPage ? '/expiration' : '/inventory' %>" class="text-green-700 py-3">Limpiar</a></div>
  </form>
  <% if (!items.length) { %><div class="bg-white rounded-xl shadow-lg p-8 text-center"><h2 class="text-xl font-semibold text-gray-700 mb-2">No hay productos en esta página</h2><p class="text-gray-600">Añade productos o ajusta los filtros de búsqueda.</p><% if (pagination.page > 1) { %><a href="<%= expirationPage ? '/expiration' : '/inventory' %>" class="text-green-700">Volver a la primera página</a><% } %></div><% } else { %>
    <div class="bg-white rounded-xl shadow-lg overflow-hidden"><div class="overflow-x-auto" role="region" aria-label="Productos del inventario" tabindex="0"><table class="w-full"><caption class="sr-only">Productos de tu empresa, ordenados por fecha de caducidad</caption>
      <thead class="bg-gray-50 border-b"><tr><% for (const label of ['Producto', 'Categoría', 'Fecha Caducidad', 'Cantidad', 'Estado', 'Acciones']) { %><th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase"><%= label %></th><% } %></tr></thead>
      <tbody class="divide-y divide-gray-200"><% for (const item of items) { const state = expiration(item.expiresDate); %><tr class="hover:bg-gray-50" data-item="<%= item.id %>">
        <th scope="row" class="px-6 py-4 text-left font-medium"><a class="text-green-700" href="/inventory/<%= item.id %>"><%= item.name %></a></th><td class="px-6 py-4 text-gray-600"><%= item.category.name %></td><td class="px-6 py-4 whitespace-nowrap"><%= displayDate(item.expiresDate) %></td><td class="px-6 py-4 whitespace-nowrap"><%= item.quantity %> <%= item.unit %></td>
        <td class="px-6 py-4"><span class="inline-block rounded-lg border-l-4 px-3 py-2 <%= state.classes %>"><%= state.label %></span><% if (item.quantity.lte(item.minimumStock)) { %><span class="block text-red-800 font-medium mt-2">Stock bajo</span><% } %></td><td class="px-6 py-4"><div class="flex gap-3"><a href="/inventory/<%= item.id %>/edit" class="text-blue-700 font-medium">Editar</a><% if (currentUser.role === 'ADMIN') { %><a href="/inventory/<%= item.id %>/delete" class="text-red-700 font-medium">Eliminar</a><% } %></div></td>
      </tr><% } %></tbody>
    </table></div></div>
  <% } %><%- include('../partials/pagination') %>
  <% if (expirationPage) { %><div class="mt-6 bg-blue-50 border-l-4 border-blue-500 p-4 rounded-lg"><h2 class="font-semibold text-blue-900 mb-1">Consejo</h2><p class="text-blue-800 text-sm">Retira los productos caducados y prioriza los críticos y las advertencias. Fecha del negocio: <%= displayDate(today) %> (<%= businessTimezone %>).</p></div><% } %>
</main></body></html>
