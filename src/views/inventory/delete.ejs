<!doctype html>
<html lang="es"><head><%- include('../partials/head', { title: 'Eliminar Producto' }) %></head><body class="bg-gray-50 text-gray-800"><%- include('../partials/navigation') %>
<main id="main-content" class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8"><a href="/inventory" class="inline-flex text-green-700 font-medium mb-6">← Volver al Inventario</a><h1 class="text-3xl font-bold text-center mb-8">Eliminar Producto</h1>
  <div class="max-w-lg mx-auto bg-white p-8 rounded-xl shadow-lg"><h2 class="text-xl font-semibold mb-4 break-words">¿Eliminar <%= item.name %>?</h2><p class="text-gray-600 mb-6">Esta acción no se puede deshacer.</p><% if (error) { %><p role="alert" class="text-red-800 bg-red-50 p-4 mb-4 rounded-lg"><%= error %></p><% } %>
    <form method="post" action="/inventory/<%= item.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="flex items-start gap-3 mb-6"><input type="checkbox" name="confirm" value="yes" required class="mt-1">Confirmo que deseo eliminar este producto.</label><div class="flex flex-wrap gap-3"><button class="flex-1 bg-red-600 text-white px-4 py-3 rounded-lg font-semibold hover:bg-red-700">Eliminar Producto</button><a href="/inventory/<%= item.id %>" class="flex-1 text-center bg-gray-200 text-gray-700 px-4 py-3 rounded-lg font-semibold">Cancelar</a></div></form>
  </div>
</main></body></html>
