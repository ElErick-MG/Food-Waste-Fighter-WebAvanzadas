<%- include('../partials/fwf-ficha-inicio', { title: 'Eliminar Producto', volver: '/inventory/' + item.id }) %>
    <p class="etiqueta ficha-marca peligro">Eliminar Producto</p>
    <h1 id="ficha-titulo" class="t-modal">¿Eliminar <%= item.name %>?</h1>
    <p class="ficha-sub ayuda">Esta acción no se puede deshacer.</p>
    <% if (error) { %><p role="alert" class="ficha-aviso error"><%= error %></p><% } %>
    <form method="post" action="/inventory/<%= item.id %>/delete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="ficha-check"><input type="checkbox" name="confirm" value="yes" required><span>Confirmo que deseo eliminar este producto.</span></label>
      <div class="ficha-botones"><button type="submit" class="btn btn-grande btn-peligro">Eliminar Producto</button><a href="/inventory/<%= item.id %>" class="btn btn-sec btn-grande">Cancelar</a></div>
    </form>
<%- include('../partials/fwf-ficha-fin') %>
