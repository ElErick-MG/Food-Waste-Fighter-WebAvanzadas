<%- include('../partials/fwf-ficha-inicio', { title: item.name, volver: '/inventory' }) %>
    <% const state = expiration(item.expiresDate); const low = item.quantity.lte(item.minimumStock); %>
    <div class="ficha-img" data-color="<%= item.category.color || '' %>" data-nombre="<%= item.name %>">
      <% if (item.imageUrl) { %><img src="<%= item.imageUrl %>" alt="Imagen de <%= item.name %>" width="320" height="240" loading="lazy" referrerpolicy="no-referrer"><% } %>
      <span class="ini-g" aria-hidden="true"><%= item.name.trim().charAt(0).toUpperCase() %></span>
    </div>
    <h1 id="ficha-titulo" class="t-modal"><%= item.name %></h1>
    <%- include('../partials/notice') %>
    <p class="ficha-estado b-<%= state.code %>"><%= state.label %></p>
    <% if (low) { %><p class="ficha-aviso pronto">Stock bajo: repón este producto.</p><% } %>
    <dl class="ficha-dl">
      <% for (const [label, value] of [['Categoría', item.category.name], ['Cantidad', item.quantity + ' ' + item.unit], ['Stock mínimo', item.minimumStock + ' ' + item.unit], ['Fecha de Ingreso', displayDate(item.receivedDate)], ['Fecha de Caducidad', displayDate(item.expiresDate)]]) { %>
      <div><dt><%= label %></dt><dd><%= value %></dd></div>
      <% } %>
    </dl>
    <div class="ficha-botones">
      <a href="/inventory/<%= item.id %>/edit" class="btn btn-pri btn-grande">Editar Producto</a>
      <% if (currentUser.role === 'ADMIN') { %><a href="/inventory/<%= item.id %>/delete" class="btn btn-sec btn-grande peligro">Eliminar Producto</a><% } %>
    </div>
    <p class="ficha-pie"><a class="enlace" href="/inventory">← Volver a la refri</a></p>
<%- include('../partials/fwf-ficha-fin') %>
