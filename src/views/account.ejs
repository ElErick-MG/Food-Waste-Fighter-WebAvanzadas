<% const rol = currentUser.role === 'ADMIN' ? 'Administración' : 'Empleado'; %>
<%- include('partials/fwf-ficha-inicio', { title: 'Mi cuenta', volver: '/dashboard' }) %>
    <p class="etiqueta ficha-marca"><%= currentUser.company.name %></p>
    <h1 id="ficha-titulo" class="t-modal">Hola, <%= currentUser.name %></h1>
    <dl class="ficha-dl ficha-dl-1">
      <div><dt>Correo electrónico</dt><dd><%= currentUser.email %></dd></div>
      <div><dt>Rol</dt><dd><%= rol %></dd></div>
    </dl>
    <div class="ficha-botones">
      <% if (currentUser.role === 'ADMIN') { %><a href="/team" class="btn btn-pri btn-grande">Administrar equipo</a><% } %>
      <form method="post" action="/auth/logout" class="ficha-salir"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sec btn-grande">Cerrar sesión</button></form>
    </div>
    <p class="ficha-pie"><a class="enlace" href="/dashboard">← Volver al resumen</a></p>
<%- include('partials/fwf-ficha-fin') %>
