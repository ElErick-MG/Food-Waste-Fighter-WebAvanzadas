<!DOCTYPE html>
<html lang="es" class="fwf-raiz">
<head><%- include('partials/fwf-head', { title: 'Resumen', estilos: ['fwf-app', 'ficha', 'resumen', 'chat'], modulos: ['resumen', 'chat', 'superpuesta'] }) %></head>
<body class="fwf"<% if (typeof transicion !== 'undefined' && transicion) { %> data-transicion<% } %>>
<%# Fondo: la cocina (se descubre con tinta al llegar desde la portada) y la refri cerrada en su nicho. %>
<div id="escena" aria-hidden="true">
  <div id="cocinaCapa">
    <svg viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid slice">
      <defs>
        <filter id="tinta" x="-25%" y="-25%" width="150%" height="150%"><feTurbulence type="fractalNoise" baseFrequency=".011" numOctaves="3" seed="7" result="ruido"/><feDisplacementMap in="SourceGraphic" in2="ruido" scale="140" xChannelSelector="R" yChannelSelector="G"/></filter>
        <mask id="mTinta" maskUnits="userSpaceOnUse" x="0" y="0" width="1672" height="941"><g id="gotas" filter="url(#tinta)" fill="#fff"></g></mask>
      </defs>
      <image id="cocinaImg" href="/assets/fwf/img/cocina.webp" width="1672" height="941" preserveAspectRatio="none"/>
    </svg>
    <div id="cocinaVelo"></div>
  </div>
  <div id="lienzo"><canvas id="refri3d"></canvas></div>
</div>

<main id="resumen" aria-labelledby="resTit">
  <div class="res-izq">
    <%- include('partials/fwf-cuenta') %>
    <div class="res-saludo">
      <h1 id="resTit" class="t-pantalla">¡Hola, <%= currentUser.name %>!</h1>
      <p class="res-sub">Este es el resumen de tu inventario · <%= currentUser.company.name %></p>
    </div>
    <% if (message) { %><p role="status" class="res-aviso"><%= message %></p><% } %>
    <div class="kpis" role="group" aria-label="Indicadores del inventario">
      <% for (const [key, label, href] of [['total', 'Alimentos registrados', '/inventory'], ['soon', 'Próximos a caducar (0–5 días)', '/expiration?status=soon'], ['expired', 'Productos caducados', '/expiration?status=expired'], ['low', 'Productos con stock bajo', '/inventory?status=low']]) { %>
      <a href="<%= href %>" class="kpi<%= (key === 'expired' || key === 'low') && metrics[key] ? ' alerta' : '' %>"><span><%= label %></span><p class="kpi-n" data-metric="<%= key %>"><%= metrics[key] %></p></a>
      <% } %>
    </div>
  </div>

  <div class="res-der">
    <section class="res-bloque" aria-labelledby="hAlertas">
      <header><h2 id="hAlertas" class="t-tarjeta">Alertas de caducidad</h2><a class="enlace" href="/expiration">Ver todos →</a></header>
      <% if (!alerts.length) { %>
      <div class="res-vacio"><p><b>¡Tu inventario está vacío!</b></p><a class="enlace" href="/inventory/new">Añade tu primer producto →</a></div>
      <% } else { %>
      <ul class="res-lista">
        <% for (const item of alerts) { const state = expiration(item.expiresDate); %>
        <li><a class="alerta-it" href="/inventory#producto-<%= item.id %>">
          <span class="mini" data-color="<%= item.category?.color || '' %>" data-nombre="<%= item.name %>"><% if (item.imageUrl) { %><img src="<%= item.imageUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } %><span class="ini" aria-hidden="true"><%= item.name.trim().charAt(0).toUpperCase() %></span></span>
          <span class="txt"><b><%= item.name %><span class="sr-only">: ver en la refri</span></b>
            <small class="est est-<%= state.code %>"><i class="pc" aria-hidden="true"></i><%= state.label %> · <%= displayDate(item.expiresDate) %></small>
            <% if (item.quantity.lte(item.minimumStock)) { %><small class="est est-bajo">Stock bajo</small><% } %>
          </span>
        </a></li>
        <% } %>
      </ul>
      <% } %>
      <p class="res-nota">Fechas del negocio: <%= displayDate(today) %> (<%= businessTimezone %>). Los caducados deben retirarse del uso.</p>
    </section>

    <section class="res-bloque" aria-labelledby="hRecetas">
      <header><h2 id="hRecetas" class="t-tarjeta">Recetas sugeridas</h2><a class="enlace" href="/recipes">Ver recetas →</a></header>
      <% if (!suggested.length) { %>
      <p class="res-vacio">No hay recetas que coincidan con los productos próximos a caducar con stock disponible.</p>
      <% } else { %>
      <div class="recetas">
        <% for (const recipe of suggested) { %>
        <article class="receta">
          <h3><%= recipe.name %></h3>
          <span class="coincide">Coincide por nombre: <%= recipe.matches.join(', ') %></span>
          <p><%= recipe.description %></p>
          <a class="enlace" href="/recipes/<%= recipe.id %>">Ver receta completa<span class="sr-only">: <%= recipe.name %></span> →</a>
        </article>
        <% } %>
      </div>
      <% } %>
      <p class="res-nota">Revisa cantidades, unidades y condiciones del alimento antes de preparar una receta.</p>
    </section>
  </div>

  <a id="abrirRefri" class="btn btn-pri btn-grande res-abrir" href="/inventory">Abrir mi refri</a>
</main>

<div id="inventory-live" class="aviso-vivo hidden" role="status" aria-live="polite"><span id="inventory-live-text"></span> <a class="enlace" href="/inventory">Ver inventario</a></div>
<%- include('partials/fwf-chat') %>
</body>
</html>
