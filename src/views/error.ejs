<!doctype html>
<html lang="es">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/assets/styles.css"></head>
<body class="bg-stone-50 text-stone-900"><main class="max-w-3xl mx-auto p-8"><h1 class="text-2xl font-bold mb-4"><%= title %></h1><p class="mb-4"><%= message %></p><% if (typeof errorCode !== 'undefined') { %><p class="text-sm text-stone-600 mb-4">Referencia: <%= errorCode %></p><% } %><a class="text-emerald-800 underline" href="/">Volver al inicio</a></main></body>
</html>
