<%# Página de error con el diseño nuevo. No depende de la sesión: se usa también antes de ella (404 de la portada). %>
<% const conSesion = typeof currentUser !== 'undefined' && currentUser; %>
<%- include('partials/fwf-ficha-inicio', { title, volver: conSesion ? '/dashboard' : '/' }) %>
    <p class="etiqueta ficha-marca">Food Waste Fighter</p>
    <h1 id="ficha-titulo" class="t-modal"><%= title %></h1>
    <p class="ficha-sub"><%= message %></p>
    <% if (typeof errorCode !== 'undefined') { %><p class="ayuda">Referencia: <%= errorCode %></p><% } %>
    <div class="ficha-botones">
      <% if (conSesion) { %><a class="btn btn-pri btn-grande" href="/dashboard">Ir al resumen</a><% } %>
      <a class="btn <%= conSesion ? 'btn-sec' : 'btn-pri' %> btn-grande" href="/">Volver al inicio</a>
    </div>
<%- include('partials/fwf-ficha-fin') %>
