<% const iniciales = nombre => nombre.trim().split(/\s+/).slice(0, 2).map(palabra => palabra[0] || '').join('').toUpperCase(); %>
<%- include('../partials/fwf-ficha-inicio', { title: 'Equipo', volver: '/dashboard', ancho: true, acceso: true }) %>
    <p class="etiqueta ficha-marca"><%= currentUser.company.name %></p>
    <h1 id="ficha-titulo" class="t-modal">Equipo de <%= currentUser.company.name %></h1>
    <div class="eq-grid">
      <section class="eq-col" aria-labelledby="hPersonas">
        <h2 id="hPersonas" class="t-tarjeta">Personas del negocio</h2>
        <ul class="cat-lista">
          <% for (const user of users) { const admin = user.role === 'ADMIN'; %>
          <li class="cat-item eq-item">
            <span class="av<%= admin ? '' : ' suave' %>" aria-hidden="true"><%= iniciales(user.name) %></span>
            <span class="nom"><b><%= user.name %></b><span><%= user.email %></span></span>
            <span class="rol<%= admin ? ' admin' : '' %>"><%= admin ? 'Administración' : 'Empleado' %></span>
          </li>
          <% } %>
        </ul>
      </section>
      <form method="post" action="/team" data-password-form class="eq-col eq-form">
        <h2 class="t-tarjeta">Añadir empleado</h2>
        <% if (error) { %><p role="alert" class="ficha-aviso error"><%= error %></p><% } %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="campo"><label for="name">Nombre Completo</label><input id="name" name="name" required minlength="2" maxlength="120" autocomplete="off" placeholder="Nombre y apellido"></div>
        <div class="campo"><label for="email">Correo Electrónico</label><input id="email" name="email" type="email" inputmode="email" required maxlength="254" autocomplete="off" placeholder="persona@negocio.com"></div>
        <%- include('../partials/fwf-clave', { id: 'password', name: 'password', label: 'Contraseña inicial', autocomplete: 'new-password', placeholder: 'Mínimo 12 caracteres', minlength: 12 }) %>
        <%- include('../partials/fwf-clave', { id: 'confirmPassword', name: 'confirmPassword', label: 'Confirmar Contraseña', autocomplete: 'new-password', placeholder: 'Repite la contraseña', describedby: 'errorContrasena' }) %>
        <p id="errorContrasena" class="err hidden" aria-live="polite">Las contraseñas no coinciden</p>
        <p class="ayuda">Compártela con la persona por un medio seguro. Entrará con el rol Empleado.</p>
        <button type="submit" class="btn btn-pri btn-grande">Añadir empleado</button>
      </form>
    </div>
    <p class="ficha-pie"><a class="enlace" href="/dashboard">← Volver al resumen</a></p>
<%- include('../partials/fwf-ficha-fin') %>
