<%#
  Chat del equipo con el diseño nuevo. Lo mueve /assets/realtime.js (Socket.IO, contratos
  chat:ready/history/send/message/presence) a través de los mismos ids de siempre;
  chat-burbuja.js solo añade la burbuja, la ventana y los avisos.
  pagina = true  → ventana fija de /chat, con la sala y el historial del servidor.
  pagina = false → burbuja flotante; la sala llega en chat:ready.
%>
<% const esPagina = typeof pagina !== 'undefined' && pagina;
   const hora = fecha => new Date(fecha).toLocaleString('es', { timeZone: businessTimezone, day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); %>
<% if (!esPagina) { %>
<button type="button" id="chatBurbuja" aria-expanded="false" aria-controls="chatVentana" aria-label="Abrir chat del equipo" hidden>
  <span class="ico ico-chat" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></span>
  <span class="ico ico-x" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
  <span class="chat-badge" hidden></span>
</button>
<button type="button" id="chatAsoma" hidden></button>
<% } %>
<section id="chatVentana" class="<%= esPagina ? 'chat-pagina' : 'chat-flotante' %>" <% if (!esPagina) { %>role="dialog" aria-modal="false" hidden <% } %>aria-labelledby="chatTit" data-chat-room="<%= esPagina ? room.id : '' %>">
  <header class="chat-cab">
    <div class="tit">
      <<%= esPagina ? 'h1' : 'h2' %> id="chatTit">Chat del equipo</<%= esPagina ? 'h1' : 'h2' %>>
      <p><%= currentUser.company.name %> · Sala <%= esPagina ? room.name : 'General' %></p>
    </div>
    <div class="chat-pres" id="chatPresencia"><span class="chat-avs" id="chatAvs" aria-hidden="true"></span><span><span id="chat-count">0</span> <span id="chatConectTxt">conectados</span></span></div>
    <% if (!esPagina) { %><button type="button" class="chat-x" id="chatCerrar" aria-label="Cerrar chat"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button><% } %>
  </header>
  <p id="chat-status" class="chat-estado" role="status">Conectando…</p>
  <div class="chat-cuerpo">
    <button id="chat-older" type="button" class="enlace chat-antes"<% if (!esPagina || !history.hasMore) { %> hidden<% } %>>Cargar mensajes anteriores</button>
    <ol id="chat-messages" aria-label="Mensajes" aria-live="polite" aria-relevant="additions">
      <% if (esPagina) { for (const message of history.messages) { %><li data-message-id="<%= message.id %>" data-created-at="<%= message.createdAt %>" data-sender-id="<%= message.sender.id %>"><p><%= message.sender.name %> <time datetime="<%= message.createdAt %>"><%= hora(message.createdAt) %></time></p><p><%= message.content %></p></li><% } } %>
    </ol>
    <p id="chat-empty" class="chat-vacio"<% if (esPagina && history.messages.length) { %> hidden<% } %>>Aún no hay mensajes. Saluda a tu equipo y coordinen qué usar primero.</p>
  </div>
  <div class="chat-pie">
    <form id="chat-form" class="chat-form">
      <label for="chat-content" class="sr-only">Mensaje (hasta 2000 caracteres)</label>
      <textarea id="chat-content" name="content" required minlength="1" maxlength="2000" rows="1" placeholder="Escribe un mensaje" disabled></textarea>
      <button id="chat-send" type="submit" class="chat-enviar" aria-label="Enviar mensaje" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </form>
    <p id="chat-error" class="chat-error" role="alert"></p>
    <p class="chat-ayuda"><span id="chatCont">0/2000</span> · Enter envía, Mayús+Enter salta de línea</p>
    <noscript><p class="chat-error">Activa JavaScript para enviar mensajes en tiempo real.</p></noscript>
  </div>
  <ul id="chat-users" class="sr-only" aria-label="Personas conectadas"></ul>
</section>
