<%#
  Campana de avisos del chat del equipo.
  Sin JavaScript sigue siendo un desplegable (<details>) con el enlace al chat; con
  JavaScript, /assets/realtime.js rellena el contador y las vistas previas usando los
  mismos eventos del chat (chat:ready, chat:history, chat:message). No crea sala ni
  eventos nuevos: escucha la sala General de la empresa.
  Se coloca junto al chip de cuenta; el panel usa los mismos tokens de vidrio.
%>
<details class="avisos" id="avisos">
  <summary class="avisos-chip" id="avisosBoton" aria-label="Notificaciones del chat del equipo">
    <span class="avisos-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
    <span class="avisos-badge" id="avisosBadge" aria-hidden="true" hidden></span>
  </summary>
  <div class="avisos-panel">
    <header class="avisos-cab">
      <p class="etiqueta">Chat del equipo</p>
      <p class="t-tarjeta">Mensajes nuevos</p>
    </header>
    <p class="avisos-vacio" id="avisosVacio">No hay mensajes nuevos.</p>
    <ol class="avisos-lista" id="avisosLista" aria-label="Vistas previas de mensajes sin leer"></ol>
    <a class="enlace" href="/chat">Abrir el chat del equipo</a>
    <p class="sr-only" id="avisosEstado" role="status"></p>
  </div>
</details>
