<%#
  Composición de la portada: titular, marca, refri 3D y grano.
  inicio = true  → portada interactiva (enlaces de acceso y pista para abrir la refri).
  inicio = false → fondo decorativo detrás de las tarjetas de acceso (sin enlaces).
%>
<section id="hero"<% if (inicio) { %> aria-label="Presentación"<% } %>>
  <p class="titular" aria-hidden="true"><span class="m"><span>Salva</span></span><span class="m"><span>tu</span></span><span class="m"><span>comida</span></span></p>
  <p class="bajada etiqueta"><span class="m"><span>Tu despensa</span></span><i aria-hidden="true"></i><span class="m"><span>sin desperdicio</span></span></p>
  <p class="marca">
    <span class="etiqueta m"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19C5 11 11 5 19 5c0 8-6 14-14 14z"/><path d="M5 19l9-9"/></svg>Tu refri te avisa</span></span>
    <b class="m"><span>Food Waste</span></b><b class="m"><span>Fighter</span></b>
  </p>
  <% if (inicio) { %>
  <nav class="acceso" aria-label="Cuenta">
    <a href="/auth/login" class="btn btn-sec">Iniciar sesión</a>
    <a href="/auth/register" class="btn btn-pri">Comenzar gratis</a>
  </nav>
  <% } %>
  <div class="grano" aria-hidden="true"></div>
</section>
<div id="lienzo"><canvas id="refri3d" aria-hidden="true"></canvas></div>
<% if (inicio) { %>
<a id="pista" href="/dashboard">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0 0V8.5a1.5 1.5 0 0 1 3 0V11m0 0a1.5 1.5 0 0 1 3 0v3a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L4.3 14a1.5 1.5 0 0 1 2.4-1.8L9 14"/><path d="M5 3.5l1.2 1.4M2.8 7l1.7.6M10.5 1.5v1.6"/></svg>
  Toca la refri para abrirla
</a>
<% } %>
