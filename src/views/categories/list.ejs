<% const admin = currentUser.role === 'ADMIN'; const txtN = k => `${k} ${k === 1 ? 'producto' : 'productos'}`; %>
<%- include('../partials/fwf-ficha-inicio', { title: 'Categorías', volver: '/inventory', ancho: true }) %>
    <p class="etiqueta ficha-marca">Estantes de tu refri</p>
    <h1 id="ficha-titulo" class="t-modal">Categorías</h1>
    <p class="ficha-sub ayuda"><%= admin ? 'Edita el nombre o el color, o elimina las que ya no uses. Cada categoría es un estante de tu refri.' : 'Cada categoría es un estante de tu refri. Solo administración puede cambiarlas.' %></p>
    <%- include('../partials/notice') %>
    <% if (error) { %><p role="alert" class="ficha-aviso error"><%= error %></p><% } %>

    <% if (!categories.length) { %>
    <p class="ficha-aviso pronto">No hay categorías registradas.</p>
    <% } else { %>
    <ul class="cat-lista" aria-label="Categorías creadas">
      <% for (const category of categories) { const editando = values.id === category.id; const color = (category.color || '').toUpperCase(); %>
      <li class="cat-item">
        <div class="cat-fila">
          <i class="pc t-<%= color.slice(1) %>" data-color="<%= color %>" aria-hidden="true"></i>
          <span class="nom"><b><%= category.name %></b><span><%= txtN(category._count.items) %></span></span>
          <% if (admin) { %><a class="enlace peligro cat-borrar" href="/categories/<%= category.id %>/delete">Eliminar<span class="sr-only"> <%= category.name %></span></a><% } %>
        </div>
        <% if (admin) { %>
        <details class="cat-editar"<% if (editando) { %> open<% } %>>
          <summary>Editar<span class="sr-only"> <%= category.name %></span></summary>
          <form method="post" action="/categories/<%= category.id %>/edit">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="campo"><label for="name-<%= category.id %>">Nombre de <%= category.name %></label><input id="name-<%= category.id %>" name="name" required minlength="2" maxlength="80" value="<%= editando && typeof values.name === 'string' ? values.name : category.name %>"></div>
            <%- include('../partials/fwf-tintes', { palette, nombreGrupo: 'Color de ' + category.name, prefijo: 'color-' + category.id, elegido: editando && typeof values.color === 'string' ? values.color : (category.color || '') }) %>
            <div class="ficha-botones"><button type="submit" class="btn btn-pri">Actualizar</button></div>
          </form>
        </details>
        <% } %>
      </li>
      <% } %>
    </ul>
    <% } %>

    <% if (admin) { %>
    <form method="post" action="/categories" class="cat-nueva">
      <h2 class="t-tarjeta">Nueva categoría</h2>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo"><label for="name">Nombre de la categoría</label><input id="name" name="name" required minlength="2" maxlength="80" placeholder="Congelados" value="<%= !values.id && typeof values.name === 'string' ? values.name : '' %>"></div>
      <%- include('../partials/fwf-tintes', { palette, nombreGrupo: 'Color', prefijo: 'color-nueva', elegido: !values.id && typeof values.color === 'string' && values.color ? values.color : nextColor }) %>
      <div class="ficha-botones"><button type="submit" class="btn btn-pri btn-grande">Guardar Categoría</button></div>
    </form>
    <% } %>
    <p class="ficha-pie"><a class="enlace" href="/inventory">← Volver a la refri</a></p>
<%- include('../partials/fwf-ficha-fin') %>
