<!doctype html>
<html lang="es"><head><%- include('../partials/head', { title: 'Categorías' }) %></head><body class="bg-gray-50 text-gray-800"><%- include('../partials/navigation') %>
<main id="main-content" class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8"><h1 class="text-3xl font-bold mb-6">Categorías</h1><%- include('../partials/notice') %>
  <% if (error) { %><p role="alert" class="text-red-800 bg-red-50 p-4 mb-6 rounded-lg"><%= error %></p><% } %>
  <% if (currentUser.role === 'ADMIN') { %><div class="bg-white p-6 rounded-xl shadow-lg mb-6"><h2 class="text-xl font-semibold mb-4">Añadir Categoría</h2><form method="post" action="/categories" class="flex flex-wrap items-end gap-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="flex-1 min-w-0"><label for="name" class="block text-sm font-medium mb-1">Nombre de la categoría</label><input id="name" name="name" required minlength="2" maxlength="80" value="<%= !values.id && typeof values.name === 'string' ? values.name : '' %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg"></div><button class="bg-green-600 text-white px-4 py-3 rounded-lg font-medium hover:bg-green-700">Guardar Categoría</button></form></div><% } %>
  <% if (!categories.length) { %><div class="bg-white p-8 rounded-xl shadow-lg text-center"><p>No hay categorías registradas.</p></div><% } %>
  <div class="grid gap-4 sm:grid-cols-2"><% for (const category of categories) { %><section class="bg-white p-6 rounded-xl shadow-lg min-w-0"><h2 class="text-xl font-semibold break-words"><%= category.name %></h2><p class="text-gray-600 my-3"><%= category._count.items %> productos</p>
    <% if (currentUser.role === 'ADMIN') { %><form method="post" action="/categories/<%= category.id %>/edit" class="space-y-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="name-<%= category.id %>" class="block text-sm font-medium">Editar nombre de <%= category.name %></label><input id="name-<%= category.id %>" name="name" required minlength="2" maxlength="80" value="<%= values.id === category.id && typeof values.name === 'string' ? values.name : category.name %>" class="w-full px-4 py-3 border border-gray-300 rounded-lg"><div class="flex flex-wrap items-center gap-4"><button class="text-blue-700 font-medium">Actualizar</button><a href="/categories/<%= category.id %>/delete" class="text-red-700 font-medium">Eliminar</a></div></form><% } %>
  </section><% } %></div>
</main></body></html>
