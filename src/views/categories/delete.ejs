<%- include('../partials/fwf-ficha-inicio', { title: 'Eliminar Categoría', volver: '/categories' }) %>
    <p class="etiqueta ficha-marca peligro">Eliminar Categoría</p>
    <h1 id="ficha-titulo" class="t-modal">¿Eliminar <%= category.name %>?</h1>
    <p class="ficha-sub ayuda">Solo se puede eliminar una categoría sin productos. Esta acción no se puede deshacer.</p>
    <% if (error) { %><p role="alert" class="ficha-aviso error"><%= error %></p><% } %>
    <form method="post" action="/categories/<%= category.id %>/delete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="ficha-check"><input type="checkbox" name="confirm" value="yes" required><span>Confirmo la eliminación de esta categoría.</span></label>
      <div class="ficha-botones"><button type="submit" class="btn btn-grande btn-peligro">Eliminar Categoría</button><a href="/categories" class="btn btn-sec btn-grande">Cancelar</a></div>
    </form>
<%- include('../partials/fwf-ficha-fin') %>
