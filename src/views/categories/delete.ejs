<!doctype html>
<html lang="es"><head><%- include('../partials/head', { title: 'Eliminar Categoría' }) %></head><body class="bg-gray-50 text-gray-800"><%- include('../partials/navigation') %>
<main id="main-content" class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8"><a href="/categories" class="inline-flex text-green-700 font-medium mb-6">← Volver a Categorías</a><div class="max-w-lg mx-auto bg-white p-8 rounded-xl shadow-lg"><h1 class="text-2xl font-bold mb-4 break-words">¿Eliminar <%= category.name %>?</h1><p class="text-gray-600 mb-6">Solo se puede eliminar una categoría sin productos.</p><% if (error) { %><p role="alert" class="text-red-800 bg-red-50 p-4 rounded-lg mb-4"><%= error %></p><% } %>
  <form method="post" action="/categories/<%= category.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="flex gap-3 mb-6"><input type="checkbox" name="confirm" value="yes" required>Confirmo la eliminación de esta categoría.</label><div class="flex flex-wrap gap-4"><button class="bg-red-600 text-white px-4 py-3 rounded-lg font-semibold">Eliminar Categoría</button><a href="/categories" class="bg-gray-200 text-gray-700 px-4 py-3 rounded-lg font-semibold">Cancelar</a></div></form>
</div></main></body></html>
