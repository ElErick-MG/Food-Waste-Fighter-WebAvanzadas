<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { title: 'Lucha contra el desperdicio' }) %></head>
<body class="bg-gray-50 text-gray-800">

    <!-- NAVBAR PÚBLICA -->
    <nav class="navbar relative">
        <div class="navbar-container">
            <div class="navbar-content flex justify-between items-center h-16">
                <div class="flex items-center">
                    <a href="/" class="navbar-logo" aria-label="Food Waste Fighter — Inicio">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                        <span class="hidden sm:inline">Food Waste Fighter</span>
                    </a>
                </div>
                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-4">
                    <a href="/auth/login" class="text-gray-600 hover:text-green-600 font-medium">
                        Iniciar Sesión
                    </a>
                    <a href="/auth/register" class="btn btn-primary">
                        Comenzar Gratis
                    </a>
                </div>
                <!-- Mobile menu button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" type="button" class="text-gray-600 hover:text-green-600 focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-md absolute w-full left-0">
            <div class="px-4 pt-4 pb-6 flex flex-col gap-4">
                <a href="/auth/login" class="block text-center text-gray-600 hover:text-green-600 font-medium py-2">
                    Iniciar Sesión
                </a>
                <a href="/auth/register" class="btn btn-primary text-center block w-full">
                    Comenzar Gratis
                </a>
            </div>
        </div>
    </nav>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-container">
        <div class="hero-section page-transition">
            <!-- Columna de Texto -->
            <div class="w-full md:w-1/2 text-center md:text-left flex flex-col items-center md:items-start">
                <span class="hero-badge">
                    Reducir, Reutilizar, Transformar
                </span>
                <h1 class="hero-title">
                    Lucha contra el
                    <span class="hero-title-highlight block md:inline">desperdicio de comida</span>
                </h1>
                <p class="hero-description text-center md:text-left">
                    Transforma tu relación con la comida. Descubre cómo reducir desperdicios, ahorrar dinero y cuidar el planeta con nuestras soluciones innovadoras.
                </p>
                <div class="flex gap-4 justify-center md:justify-start w-full">
                    <a href="/auth/register" class="btn btn-primary text-lg w-full sm:w-auto">
                        Comenzar Ahora
                    </a>
                </div>
            </div>
        </div>

        <!-- SECCIÓN DE CARACTERÍSTICAS -->
        <section class="features-section">
            <div class="features-header">
                <h2 class="features-title">Características Poderosas</h2>
                <p class="features-subtitle">Herramientas diseñadas para hacer la diferencia en tu negocio y en el planeta.</p>
            </div>

            <div class="features-grid">
                <!-- Característica 1: Reduce Desperdicios -->
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                    </div>
                    <h3 class="feature-title">Reduce Desperdicios</h3>
                    <p class="feature-description">Control de alimentos y fechas para reducir el desperdicio en tu negocio.</p>
                </div>

                <!-- Característica 2: Recetas Inteligentes -->
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                    </div>
                    <h3 class="feature-title">Recetas Inteligentes</h3>
                    <p class="feature-description">Descubre recetas personalizadas basadas en ingredientes que tienes a punto de vencer.</p>
                </div>

                <!-- Característica 3: Análisis Detallado -->
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                    </div>
                    <h3 class="feature-title">Análisis Detallado</h3>
                    <p class="feature-description">Información de inventario para tomar decisiones sobre tus alimentos.</p>
                </div>

                <!-- Característica 4: Comunidad Activa -->
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                    <h3 class="feature-title">Comunidad Activa</h3>
                    <p class="feature-description">Coordinación entre las personas que forman parte de tu negocio.</p>
                </div>
            </div>
        </section>

    </main>

    <section class="bg-gray-200 py-16 md:py-24" aria-label="Nuestro propósito">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-green-700 mb-4">Pequeños cambios, menos desperdicio</h2>
        <p class="text-gray-600">Una iniciativa para aprovechar los alimentos y cuidar los recursos de tu negocio.</p>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer-section">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Grid principal del footer -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <!-- Columna 1: Logo y descripción -->
                <div>
                    <div class="flex items-center gap-2 mb-4">
                        <div class="bg-green-600 rounded-lg p-2">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                            </svg>
                        </div>
                        <span class="text-white font-bold text-lg">Food Waste Fighter</span>
                    </div>
                    <p class="text-sm text-gray-400">
                        Transformando la forma en que las personas interactúan con la comida.
                    </p>
                </div>
            </div>

            <!-- Línea divisoria -->
            <div class="border-t border-gray-800 pt-8">
                <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                    <a class="footer-link" href="/ready">Disponibilidad del servicio</a>
                    <!-- Copyright -->
                    <p class="text-sm text-gray-400">
                        © 2026 Food Waste Fighter. Todos los derechos reservados.
                    </p>

                    <!-- Redes sociales -->
                    <div class="flex gap-6">
                        <a href="https://x.com/" class="footer-link hover:text-green-500">
                            <span class="sr-only">Twitter</span>
                            Twitter
                        </a>
                        <a href="https://www.instagram.com/" class="footer-link hover:text-green-500">
                            <span class="sr-only">Instagram</span>
                            Instagram
                        </a>
                        <a href="https://www.linkedin.com/" class="footer-link hover:text-green-500">
                            <span class="sr-only">LinkedIn</span>
                            LinkedIn
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
