<%- include('../partials/fwf-ficha-inicio', { title: recipe.name, volver: '/recipes', ancho: true }) %>
    <p class="etiqueta ficha-marca">Receta</p>
    <h1 id="ficha-titulo" class="t-modal"><%= recipe.name %></h1>
    <p class="ficha-sub ayuda"><%= recipe.description %></p>
    <% if (typeof message !== 'undefined' && message) { %><p role="status" class="ficha-aviso pronto"><%= message %></p><% } %>
    <section class="rec-bloque" aria-labelledby="hIngredientes">
      <h2 id="hIngredientes" class="t-tarjeta">Ingredientes</h2>
      <p class="ayuda">✓ indica coincidencia por nombre con un producto no caducado y con stock. Revisa cantidades, unidades y condiciones; no garantiza que alcance para la receta.</p>
      <ul class="ingredientes">
        <% for (const ingredient of ingredients) { %>
        <li class="ingrediente<%= ingredient.available ? ' disponible' : '' %>" data-ingredient="<%= ingredient.id %>" data-available="<%= ingredient.available %>">
          <span class="marca" aria-hidden="true"><%= ingredient.available ? '✓' : '–' %></span>
          <span><%= ingredient.quantity %> <%= ingredient.unit %> de <strong><%= ingredient.name %></strong> — <%= ingredient.available ? 'Coincide con tu inventario' : 'Sin coincidencia disponible' %></span>
        </li>
        <% } %>
      </ul>
    </section>
    <section class="rec-bloque" aria-labelledby="hPreparacion">
      <h2 id="hPreparacion" class="t-tarjeta">Preparación</h2>
      <ol class="pasos">
        <% for (const step of recipe.preparation.split(/\r?\n/).filter(step => step.trim())) { %><li><%= step %></li><% } %>
      </ol>
    </section>
    <aside class="ficha-consejo"><h2 class="t-tarjeta">Consejo</h2><p class="ayuda">Prioriza los ingredientes próximos a caducar. Los productos caducados o sin stock no se marcan como disponibles.</p></aside>
    <p class="ficha-pie"><a class="enlace" href="/recipes">← Volver a Recetas</a></p>
<%- include('../partials/fwf-ficha-fin') %>
