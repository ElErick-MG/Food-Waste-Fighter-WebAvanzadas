<%- include('../partials/fwf-ficha-inicio', { title: 'Recetas', volver: '/dashboard', ancho: true }) %>
    <p class="etiqueta ficha-marca">Aprovecha lo que tienes</p>
    <h1 id="ficha-titulo" class="t-modal">Recetas Sugeridas</h1>
    <p class="ficha-sub ayuda">Consulta las recetas de tu empresa. En cada detalle se indican las coincidencias con los alimentos de tu inventario.</p>
    <% if (currentUser.role === 'ADMIN') { %>
    <p class="ficha-botones"><a class="btn btn-pri" href="/recipes/new">Agregar receta</a></p>
    <% } %>
    <% if (!recipes.length) { %>
    <div class="lista-vacia"><h2 class="t-tarjeta">No hay recetas disponibles en esta página</h2></div>
    <% } else { %>
    <ul class="recetas-grid">
      <% for (const recipe of recipes) { %>
      <li class="receta">
        <h2><%= recipe.name %></h2>
        <p><%= recipe.description %></p>
        <a class="enlace" href="/recipes/<%= recipe.id %>">Ver receta completa<span class="sr-only">: <%= recipe.name %></span> →</a>
      </li>
      <% } %>
    </ul>
    <% } %>
    <%- include('../partials/fwf-paginacion') %>
    <aside class="ficha-consejo"><h2 class="t-tarjeta">¿Sabías que...?</h2><p class="ayuda">Aprovechar ingredientes próximos a caducar ayuda a reducir el desperdicio de alimentos.</p></aside>
    <p class="ficha-pie"><a class="enlace" href="/dashboard">← Volver al resumen</a></p>
<%- include('../partials/fwf-ficha-fin') %>
